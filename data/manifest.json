  "unreviewed_text": [
    {
      "source": "corpus_content.HINDI_TITLE",
      "status": "unreviewed",
      "text": "Voltara AC-7 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0917\u093e\u0907\u0921",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINDI_LINES[0]",
      "status": "unreviewed",
      "text": "\u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 E-101 (\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092b\u0947\u0932\u094d\u092f\u094b\u0930): \u0932\u0940\u0915\u0947\u091c \u0915\u0930\u0902\u091f 30 mA \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u091a\u093e\u0930\u094d\u091c\u0930 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u092c\u094d\u0930\u0947\u0915\u0930 Q1 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902, 2 \u092e\u093f\u0928\u091f \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 PE \u0928\u093f\u0930\u0902\u0924\u0930\u0924\u093e \u092e\u093e\u092a\u0947\u0902 (0.3 \u0913\u092e \u0938\u0947 \u0915\u092e \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f)\u0964",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINDI_LINES[1]",
      "status": "unreviewed",
      "text": "\u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 E-102 (\u0913\u0935\u0930\u0915\u0930\u0902\u091f): \u0906\u0909\u091f\u092a\u0941\u091f \u0915\u0930\u0902\u091f 40 A \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 100 \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u092c\u093e\u0926 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u0947\u092c\u0932 \u0914\u0930 \u0915\u0928\u0947\u0915\u094d\u091f\u0930 \u092e\u0947\u0902 \u0936\u0949\u0930\u094d\u091f \u0938\u0930\u094d\u0915\u093f\u091f \u091c\u093e\u0901\u091a\u0947\u0902\u0964",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINDI_LINES[2]",
      "status": "unreviewed",
      "text": "\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u094b\u091f: \u0915\u0948\u092a\u0947\u0938\u093f\u091f\u0930 \u0921\u093f\u0938\u094d\u091a\u093e\u0930\u094d\u091c \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u092d\u0940 \u0915\u0948\u092c\u093f\u0928\u0947\u091f \u0928 \u0916\u094b\u0932\u0947\u0902\u0964 \u0932\u0940\u0915\u0947\u091c \u091f\u094d\u0930\u093f\u092a \u0938\u0940\u092e\u093e \u0969\u0966 mA \u0939\u0948 \u0914\u0930 \u0913\u0935\u0930\u0915\u0930\u0902\u091f \u0935\u093f\u0932\u0902\u092c \u0967\u0966\u0966 \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0921 \u0939\u0948\u0964",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINGLISH_LINES[0]",
      "status": "unreviewed",
      "text": "E-101 aaye to pehle breaker Q1 off karo, 2 minute ruko, phir PE continuity check karo (0.3 ohm se kam honi chahiye).",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINGLISH_LINES[1]",
      "status": "unreviewed",
      "text": "E-102 ka matlab hai output current 40 A se zyada, 100 ms ke baad charger band ho jata hai.",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINGLISH_LINES[2]",
      "status": "unreviewed",
      "text": "Technician aksar code ko bolte hain: E one-oh-one, ya \u0908-\u0967\u0966\u0967 (ee ek zero ek).",
      "usable_as_ground_truth": false
    },
    {
      "source": "corpus_content.HINGLISH_LINES[3]",
      "status": "unreviewed",
      "text": "Safety: capacitor discharge ke bina cabinet kabhi mat kholo. Isolation ke baad DC-60 par 10 minute ruko.",
      "usable_as_ground_truth": false
    }
  ]
