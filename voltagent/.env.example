# --- LLM provider: set ONE of these. GEMINI is preferred if both are set. ---
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini              # gemini | openai
GENERATION_MODEL=gemini-1.5-flash
# GENERATION_MODEL=gpt-4o-mini   # if LLM_PROVIDER=openai

# --- Elasticsearch (BM25 leg) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=voltagent-chunks

# --- Qdrant (dense leg) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=voltagent-chunks
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- Retrieval ---
TOP_K_SPARSE=10
TOP_K_DENSE=10
TOP_K_FUSED=6
RRF_K=60                         # reciprocal rank fusion constant

# --- Verifier ---
VERIFIER_CONFIDENCE_THRESHOLD=0.55

# --- Cache ---
CACHE_BACKEND=memory             # memory | redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=2048

# --- Voice ---
DEFAULT_LANGUAGE=en              # en | hi

# --- Observability ---
LOG_LEVEL=INFO
LOG_FILE=observability/events.jsonl
